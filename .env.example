# Fundament serwera.
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/ogarniacz.sqlite
STATIC_DIR=./dist

# Jednorazowa bramka wyłącznie dla pierwszego konta Właściciela na pustym serwerze.
# Po utworzeniu konta usuń zmienną z /etc/ogarniacz/ogarniacz.env i zrestartuj usługę.
# Aktualizacje APK i zwykłe logowanie nie używają tego tokenu; pozostawiony token
# nie pozwala utworzyć drugiego pierwszego Właściciela.
OWNER_BOOTSTRAP_TOKEN=
SESSION_TTL_DAYS=30

# Pochodzenie Capacitor wynika z capacitor.config.ts. Dla dodatkowego PWA wpisz
# konkretne originy po przecinku; nie używaj "*".
CORS_ALLOWED_ORIGINS=https://localhost

# Klient otrzymuje tylko adres; uwierzytelnienie używa cookie HttpOnly i CSRF.
VITE_SYNC_API_URL=

# Pełny adres HTTPS do latest.json używany wyłącznie w buildzie Androida.
VITE_ANDROID_UPDATE_MANIFEST_URL=

# Osobny kanał Web OTA. Nie używaj /releases/latest, który należy do OTA APK.
VITE_ANDROID_WEB_UPDATE_MANIFEST_URL=

# Opcjonalny lokalny model Ollama, pełny adres /api/chat i nazwa zainstalowanego modelu.
# Puste wartości zachowują ograniczony provider offline. Nie wpisuj płatnego endpointu.
VITE_ECHO_MODEL_URL=
VITE_ECHO_MODEL=

# Opcjonalny Home Assistant — wyłącznie backend, nigdy zmienne VITE_*.
# Sekrety ustaw w /etc/ogarniacz/ogarniacz.env (uprawnienia 600).
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_OWNER_ID=
HOME_ASSISTANT_ENTITIES=
# Pusta lista wyłącza sterowanie. Dopuszczone tylko light/switch z listy powyżej.
HOME_ASSISTANT_CONTROL_ENTITIES=
HOME_ASSISTANT_TIMEOUT_MS=5000
