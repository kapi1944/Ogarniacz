# Fundament serwera; PUBLIC_URL jest opcjonalny i nie jest stałą biznesową klienta.
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/ogarniacz.sqlite
STATIC_DIR=./dist
PUBLIC_URL=

# Opcjonalny klucz migracyjny starego APK. Po przejściu na konta usuń go z serwera.
SYNC_USER_ID=wlasciciel
SYNC_ACCESS_KEY=

# Jednorazowa bramka pierwszego konta Właściciela. Ustaw długi losowy sekret,
# utwórz konto, a następnie usuń zmienną i zrestartuj usługę.
OWNER_BOOTSTRAP_TOKEN=
SESSION_TTL_DAYS=30

# Pochodzenie Capacitor wynika z capacitor.config.ts. Dla dodatkowego PWA wpisz
# konkretne originy po przecinku; nie używaj "*".
CORS_ALLOWED_ORIGINS=https://localhost

# Klient otrzymuje tylko adres; uwierzytelnienie używa cookie HttpOnly i CSRF.
VITE_SYNC_API_URL=
# Wyłącznie dla zgodności starego prywatnego APK; nie jest sekretem w bundle.
VITE_SYNC_ACCESS_KEY=

# Pełny adres HTTPS do latest.json używany wyłącznie w buildzie Androida.
VITE_ANDROID_UPDATE_MANIFEST_URL=

# Osobny kanał Web OTA. Nie używaj /releases/latest, który należy do OTA APK.
VITE_ANDROID_WEB_UPDATE_MANIFEST_URL=

# Opcjonalny lokalny model Ollama, pełny adres /api/chat i nazwa zainstalowanego modelu.
# Puste wartości zachowują ograniczony provider offline. Nie wpisuj płatnego endpointu.
VITE_ECHO_MODEL_URL=
VITE_ECHO_MODEL=
