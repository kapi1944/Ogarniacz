# Fundament serwera; PUBLIC_URL jest opcjonalny i nie jest stałą biznesową klienta.
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/ogarniacz.sqlite
STATIC_DIR=./dist
PUBLIC_URL=

# Synchronizacja jednego profilu Ogarniacza. Klucz ustaw jako długi losowy sekret.
SYNC_USER_ID=wlasciciel
SYNC_ACCESS_KEY=

# Pochodzenie Capacitor wynika z capacitor.config.ts. Dla dodatkowego PWA wpisz
# konkretne originy po przecinku; nie używaj "*".
CORS_ALLOWED_ORIGINS=https://localhost

# Zmienne przekazywane podczas budowania klienta dla prywatnego wdrożenia HTTPS/LAN.
VITE_SYNC_API_URL=
VITE_SYNC_ACCESS_KEY=

# Pełny adres HTTPS do latest.json używany wyłącznie w buildzie Androida.
VITE_ANDROID_UPDATE_MANIFEST_URL=
