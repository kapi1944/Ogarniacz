{"nodes": [{"id": "_agents_skills_ogarniacz_debugger_skill", "label": "Ogarniacz Debugger Skill", "file_type": "document", "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diagnoza celuje w konkretny przep\u0142yw i przyczyn\u0119; przy zleceniu samej diagnozy ko\u0144czy si\u0119 na ustaleniach bez wdra\u017cania poprawki, a lokalna diagnoza nie rozszerza si\u0119 do audytu repozytorium."}, {"id": "_agents_skills_ogarniacz_debugger_skill_symptom_reproduction", "label": "Odtworzenie objawu na danych syntetycznych lub minimalnym te\u015bcie", "file_type": "concept", "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reprodukcja na danych syntetycznych pozwala potwierdzi\u0107 b\u0142\u0105d bez kasowania danych u\u017cytkownika."}, {"id": "_agents_skills_ogarniacz_debugger_skill_failure_flow_trace", "label": "\u015aledzenie przep\u0142ywu od modu\u0142u przez hooki i serwisy do danych", "file_type": "concept", "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Odczyt ogranicza si\u0119 do punktu awarii, jego wywo\u0142a\u0144 i najbli\u017cszych test\u00f3w; kolejne warstwy \u015bledzi si\u0119 tylko wtedy, gdy prowadz\u0105 tam dowody."}, {"id": "_agents_skills_ogarniacz_debugger_skill_proven_cause_vs_hypothesis", "label": "Rozdzielenie potwierdzonej przyczyny od hipotezy", "file_type": "concept", "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poprawka usuwa przyczyn\u0119 w istniej\u0105cym mechanizmie, a test odtwarza b\u0142\u0105d przed zmian\u0105 \u2014 zmiana oczekiwa\u0144 testu wy\u0142\u0105cznie po to, by przeszed\u0142, jest zabroniona."}, {"id": "_agents_skills_ogarniacz_debugger_skill_safe_logging", "label": "Bezpieczne logi (bez sekret\u00f3w i prywatnych danych)", "file_type": "rationale", "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dowody diagnostyczne nie mog\u0105 ujawnia\u0107 sekret\u00f3w ani prywatnych danych, a b\u0142\u0119du nie wolno ukrywa\u0107 wy\u0142\u0105czeniem kontroli."}], "edges": [{"source": "_agents_skills_ogarniacz_debugger_skill", "target": "_agents_skills_ogarniacz_debugger_skill_symptom_reproduction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_ogarniacz_debugger_skill", "target": "_agents_skills_ogarniacz_debugger_skill_failure_flow_trace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_ogarniacz_debugger_skill", "target": "_agents_skills_ogarniacz_debugger_skill_proven_cause_vs_hypothesis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_ogarniacz_debugger_skill", "target": "_agents_skills_ogarniacz_debugger_skill_safe_logging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/ogarniacz-debugger/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_ogarniacz_debugger_skill", "target": "_agents_skills_ogarniacz_test_selector_skill", "relation": "references", "confidence": "EXTRACTED", "confid