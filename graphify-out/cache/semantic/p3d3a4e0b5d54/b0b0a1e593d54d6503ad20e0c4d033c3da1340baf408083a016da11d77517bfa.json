{"nodes": [{"id": "docs_finanse_pule_zobowiazania_pula", "label": "Pula finansowa i zakupowa (FZ)", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a75\u20136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pula jest logicznym rozszerzeniem istniej\u0105cej WspolnaKasa przechowywanym w tej samej tabeli, aby nie powstawa\u0142 drugi silnik sald ani nowa tabela pule."}, {"id": "docs_finanse_pule_zobowiazania_zobowiazanie", "label": "Zobowiazanie (nale\u017cno\u015b\u0107 i w\u0142asny d\u0142ug)", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rekord nie ma pola bie\u017c\u0105cego salda ani utrwalanego statusu sp\u0142aty, bo pozosta\u0142a kwota wynika z operacji i nadp\u0142ata musi by\u0107 widoczna w obu kierunkach."}, {"id": "docs_finanse_pule_zobowiazania_partia_produktu", "label": "PartiaProduktu (osadzona w zakupie)", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partie s\u0105 osadzone w zakupie, bo waliduje si\u0119 je wsp\u00f3lnie i nie maj\u0105 niezale\u017cnego cyklu synchronizacji; katalog produkt\u00f3w jest projekcj\u0105 po produktId."}, {"id": "docs_finanse_pule_zobowiazania_sprzedaz_puli", "label": "SprzedazPuli i PozycjaSprzedazy", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a76.2, \u00a79.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sprzeda\u017c jest jedynym \u017ar\u00f3d\u0142em rozchodu sztuk, wi\u0119c nie zapisuje si\u0119 drugiej kopii rozchodu w partii."}, {"id": "docs_finanse_pule_zobowiazania_splata_zobowiazania", "label": "SplataZobowiazania i operacje zobowi\u0105zania", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a76.2, \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_finanse_pule_zobowiazania_operacja_puli", "label": "OperacjaPuli jako projekcja dw\u00f3ch zbior\u00f3w", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projekcja sumuje operacjeKas i got\u00f3wkowe operacjeZobowiazan, bo jedna rzeczywista p\u0142atno\u015b\u0107 musi mie\u0107 dok\u0142adnie jeden kanoniczny rekord."}, {"id": "docs_finanse_pule_zobowiazania_cena_jednostkowa", "label": "Dwukierunkowa cena: ca\u0142kowita i dok\u0142adny u\u0142amek jednostkowy", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a79.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0179r\u00f3d\u0142em ceny jest kwota ca\u0142kowita, a u\u0142amek jest tylko obja\u015bnieniem, \u017ceby 3 sztuki za 10,00 PLN nie traci\u0142y grosza przez niejawne zaokr\u0105glenie."}, {"id": "docs_finanse_pule_zobowiazania_grupa_atomowa", "label": "Atomowa grupa operacji w synchronizacji", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a714.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grupa na istniej\u0105cej kolejce jest potrzebna, bo kilka niezale\u017cnych zapis\u00f3w nie czyni sprzeda\u017cy atomow\u0105, a osobna kolejka lub endpoint dublowa\u0142yby protok\u00f3\u0142."}, {"id": "docs_finanse_pule_zobowiazania_przypomnienia_zobowiazan", "label": "PrzypomnieniaZobowiazan (lokalna projekcja)", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finansowe przypomnienia s\u0105 lokaln\u0105 odtwarzaln\u0105 projekcj\u0105 istniej\u0105cego SilnikPrzypomnien, bo nie mo\u017cna obiecywa\u0107 jednego systemowego alarmu na wszystkie urz\u0105dzenia offline."}, {"id": "docs_finanse_pule_zobowiazania_koszt_nieodzyskany", "label": "Koszt nieodzyskany vs koszt nabycia", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a710.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dwie r\u00f3\u017cne metryki o podobnej nazwie s\u0105 rozdzielone, bo mylenie kosztu nabycia z odzyskaniem got\u00f3wki prowadzi\u0142oby do fa\u0142szywej rentowno\u015bci."}, {"id": "docs_finanse_pule_zobowiazania_zapas_i_koszt", "label": "Skumulowany koszt partii A(n) = floor(K*n/N)", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a710.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Koszt kolejnych wyda\u0144 liczy si\u0119 przez BigInt i skumulowan\u0105 formu\u0142\u0119, \u017ceby 3 sztuki o koszcie 1000 groszy rozdzieli\u0142y si\u0119 na 333/333/334 bez utraty grosza."}, {"id": "docs_finanse_pule_zobowiazania_osoba_finansowa", "label": "OsobaFinansowa", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Osobna tabela os\u00f3b jest konieczna, bo saldo wzajemne jednej osoby z wieloma d\u0142ugami nie mo\u017ce opiera\u0107 si\u0119 na dopasowaniu nazwy."}, {"id": "docs_finanse_pule_zobowiazania_dokument_finansowy", "label": "Dokument.finansowe \u2014 trwa\u0142a ochrona paragonu", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a712.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ochrona jest monotoniczna i niezale\u017cna od relacji, bo od\u0142\u0105czenie pliku, import starej kopii ani konflikt nie mog\u0105 zdejmowa\u0107 klasyfikacji finansowej."}, {"id": "docs_finanse_pule_zobowiazania_sekcja_pule_zobowiazania", "label": "Sekcja backupu puleZobowiazania", "file_type": "concept", "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedna sekcja jest potrzebna, bo sprzeda\u017c i jej d\u0142ug tworz\u0105 niepodzielny graf; stare sekcje musz\u0105 wyklucza\u0107 te dane, aby nie powsta\u0142y dwie kopie."}], "edges": [{"source": "docs_finanse_pule_zobowiazania_pula", "target": "docs_finanse_kasy_i_rozliczenia_wspolne_kasy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a75", "weight": 1.0}, {"source": "docs_finanse_pule_zobowiazania_pula", "target": "docs_finanse_pule_zobowiazania_operacja_puli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a76.2", "weight": 1.0}, {"source": "docs_finanse_pule_zobowiazania_sprzedaz_puli", "target": "docs_finanse_pule_zobowiazania_partia_produktu", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a76.2", "weight": 1.0}, {"source": "docs_finanse_pule_zobowiazania_sprzedaz_puli", "target": "docs_finanse_pule_zobowiazania_zobowiazanie", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FINANSE_PULE_ZOBOWIAZANIA.md", "source_location": "\u00a79.1", "weight": 1.0}, {"source": "docs_finanse_pule_zobowiazania_zobowiazanie", "target": "docs_finanse_pule_zobowiaza