[Unit]
Description=Aktualizacja Ogarniacza na Raspberry Pi

[Service]
Type=oneshot
User=kacper
Group=kacper
WorkingDirectory=/home/kacper/apps/Ogarniacz
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=npm_config_cache=/home/kacper/apps/Ogarniacz/data/aktualizacja-rpi/npm-cache
ExecStart=/usr/bin/bash /home/kacper/apps/Ogarniacz/scripts/aktualizuj-rpi.sh update
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kacper/apps/Ogarniacz
PrivateTmp=true
UMask=027
