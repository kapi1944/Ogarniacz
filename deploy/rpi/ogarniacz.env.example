# Kopiuj do /etc/ogarniacz/ogarniacz.env i ustaw właściciela root:kacper oraz tryb 0640.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=/home/kacper/apps/Ogarniacz/data/ogarniacz.sqlite
STATIC_DIR=/home/kacper/apps/Ogarniacz/dist
# Wyłącznie do utworzenia pierwszego Właściciela; po bootstrapie usuń tę zmienną z /etc/ogarniacz/ogarniacz.env.
OWNER_BOOTSTRAP_TOKEN=ZASTAP_DLUGIM_LOSOWYM_TOKENEM_JEDNORAZOWYM
SESSION_TTL_DAYS=30
# Dodaj dokładny adres https://nazwa-urzadzenia.tailnet.ts.net obok originu Androida.
CORS_ALLOWED_ORIGINS=https://localhost
# Reset hasła przez e-mail: docs/ODZYSKIWANIE_HASLA_EMAIL.md. Domyślnie wyłączony.
MAIL_PROVIDER=off
# PASSWORD_RESET_ORIGIN=https://nazwa-urzadzenia.tailnet.ts.net
# MAIL_FROM=ogarniacz@example.com
# Wariant MAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# Alternatywnie MAIL_PROVIDER=resend i klucz ograniczony do wysyłki:
# MAIL_API_KEY=
# Opcjonalny prywatny model Echo. Ollama pozostaje na loopbacku Raspberry Pi.
# ECHO_MODEL_URL=http://127.0.0.1:11434/api/chat
# ECHO_MODEL=nazwa-zainstalowanego-modelu
# ECHO_MODEL_TIMEOUT_MS=15000
# Opcjonalny Home Assistant. Token uzupełnij wyłącznie w /etc/ogarniacz/ogarniacz.env, nigdy w repozytorium.
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=
# HOME_ASSISTANT_TIMEOUT_MS=5000

# Opcjonalny timer używa tego samego aktualizatora i wyłącznie rpi-stable.
RPI_AUTO_UPDATE=0
