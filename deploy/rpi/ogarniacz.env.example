# Kopiuj do /etc/ogarniacz/ogarniacz.env i ustaw właściciela root:kacper oraz tryb 0640.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=/home/kacper/apps/Ogarniacz/data/ogarniacz.sqlite
STATIC_DIR=/home/kacper/apps/Ogarniacz/dist
# Wyłącznie do utworzenia pierwszego Właściciela; po bootstrapie usuń tę zmienną z /etc/ogarniacz/ogarniacz.env.
OWNER_BOOTSTRAP_TOKEN=ZASTAP_DLUGIM_LOSOWYM_TOKENEM_JEDNORAZOWYM
SESSION_TTL_DAYS=30
# Dodaj dokładny adres https://nazwa-urzadzenia.tailnet.ts.net obok originu Androida.
CORS_ALLOWED_ORIGINS=https://localhost
# Opcjonalny prywatny model Echo. Ollama pozostaje na loopbacku Raspberry Pi.
# ECHO_MODEL_URL=http://127.0.0.1:11434/api/chat
# ECHO_MODEL=nazwa-zainstalowanego-modelu
# ECHO_MODEL_TIMEOUT_MS=15000
