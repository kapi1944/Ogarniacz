[Unit]
Description=Ogarniacz production server
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
User=kacper
Group=kacper
WorkingDirectory=/home/kacper/apps/Ogarniacz
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/ogarniacz/ogarniacz.env
ExecStartPre=/usr/bin/test -f /home/kacper/apps/Ogarniacz/dist-server/main.js
ExecStartPre=/usr/bin/test -f /home/kacper/apps/Ogarniacz/dist/index.html
ExecStart=/usr/bin/env node dist-server/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kacper/apps/Ogarniacz/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
